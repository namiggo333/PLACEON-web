# Supabase (선택)
# 값을 비워두면 자동으로 브라우저 저장소(localStorage) 기반 데모 모드로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 예약 생성·상태 변경 서버 API 전용 (절대 브라우저에 노출하지 마세요 / Vercel 환경변수에도 동일하게 등록)
# Supabase 대시보드 → Project Settings → API → service_role 키
SUPABASE_SERVICE_ROLE_KEY=

# 사장님 예약 알림 메일 (둘 중 하나만 있으면 됩니다)
# 1) Resend — https://resend.com → API Keys (무료 100통/일)
RESEND_API_KEY=
# 2) Brevo — https://www.brevo.com → SMTP & API → API Keys (무료 300통/일)
BREVO_API_KEY=

# 보내는 사람. Resend 무료 플랜에서 도메인 인증 전에는 onboarding@resend.dev 로만 보낼 수 있고,
# 그 경우 수신자는 Resend 계정 소유자 주소만 가능합니다. 도메인을 인증하면 아래처럼 바꾸세요.
# MAIL_FROM=이곳저곳 <noreply@igotjeogot.com>
MAIL_FROM=
# 답장 받을 주소(선택)
MAIL_REPLY_TO=

# 메일 안의 "사장님 센터" 링크에 쓰는 주소
SITE_URL=https://igotjeogot.vercel.app

# /api/cron/expire-bookings 보호용(선택). 비워 두면 누구나 호출할 수 있지만,
# 하는 일은 만료 예약 정리뿐입니다. 운영에서는 Supabase pg_cron 이 1분마다 처리합니다.
CRON_SECRET=
